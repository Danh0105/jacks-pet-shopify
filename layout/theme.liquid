<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18446766637"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-18446766637');
</script>
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PetStore",
  "@id": "{{ shop.url }}/#pet-store",
  "name": "Jack's Pet Center",
  "alternateName": [
    "Jacks Pet Center",
    "Jack’s Pet Center"
  ],
  "url": "{{ shop.url }}/",
  "sameAs": [
    "{{ shop.url }}/",
    "https://www.google.com/search?kgmid=%2Fg%2F1tm882j9",
    "https://www.yelp.com/biz/jacks-pet-center-great-falls",
    "https://www.facebook.com/pages/Jacks-Pet-Center/116650045061112",
    "https://www.mapquest.com/us/montana/jacks-pet-center-7412950"
  ],
  "telephone": "+14064531821",
  "email": "support@jackspetcenter.com",
  "image": "{{ 'jacks-pet-center-logo.png' | asset_url }}",
  "logo": "{{ 'jacks-pet-center-logo.png' | asset_url }}",
  "description": "Jack's Pet Center is a local pet store in Great Falls, Montana, offering practical pet-care essentials and helpful customer support for pet parents across the United States.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "508 Central Ave",
    "addressLocality": "Great Falls",
    "addressRegion": "MT",
    "postalCode": "59401",
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    "telephone": "+14064531821",
    "email": "support@jackspetcenter.com",
    "areaServed": "US",
    "availableLanguage": "English"
  },
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "@id": "{{ shop.url }}/policies/refund-policy#policy",
    "merchantReturnLink": "{{ shop.url }}/policies/refund-policy",
    "applicableCountry": "US",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": 30,
    "returnMethod": "https://schema.org/ReturnByMail",
    "refundType": "https://schema.org/FullRefund"
  }
}
</script>
    <link rel="stylesheet" href="{{ 'jacks-pet-center.css' | asset_url }}">
    <script src="{{ 'jacks-pet-center.js' | asset_url }}" defer></script>
  </head>
  <body class="gradient {% if template.name == 'collection' %}template-collection{% endif %}{% if template.name == 'product' %}template-product {% endif %}{% if template.name == 'index' %}template-index{% endif %} {%- if settings.general_layout == 'boxed' -%}box-layout{% elsif settings.general_layout == 'full_width' %}full-width-layout{% else %}{%- endif -%} {% if settings.content_center %}item-center{% endif %} {% if settings.image_style != blank %}product-images-style-radius{% endif %} {% if template.suffix contains 'layout-2' %}product-digital-layout-2{% endif %}">
    <div class="bls-wrapper">
      {% if settings.pre_load_page %}
        <div class="preloader" id="preloader">
          <div class="preloader-icon preloader-{{ settings.icon_preload }}"></div>
        </div>
      {% endif %}
      <div class="bls__overlay d-none-overlay"></div>
      {%- sections 'header-group' -%}
      <main
        id="MainContent"
        class="content-for-layout focus-none{% if template == 'product' or template == 'page.wishlist' or template == "page.recently-viewed-products" %} skeleton-product-detail{% endif %}"
        role="main"
        tabindex="-1"
      >
        {{ content_for_layout }}
      </main>
      {%- sections 'overlay-group' -%}
      {%- sections 'footer-group' -%}
      {%- section 'mobile-stickybar' -%}
      {%- section 'custom-colors' -%}
    </div>
    {%- render 'content-bottom' -%}
    {%- render 'scripts-tag' -%}
    {{ shop.metafields.loox.global_html_body }}
  </body>
</html>
